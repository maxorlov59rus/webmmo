# Конфигурация сервера «Ночь Военного Ремесла» (копировать в server/.env)
PORT=3000
WS_PATH=/ws
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=nvr_game
DB_AUTOINIT=1
NO_DB=0
TICK_MS=50
MOVE_RATE_HZ=15
CHAT_RATE_PER_S=2
MAX_PLAYERS_WS=200
HEARTBEAT_MS=30000
IDLE_TIMEOUT_MS=90000
SAVE_EVERY_S=30
PUBLIC_MODE=0
PUBLIC_HOST=
ALLOW_REG=1
LOG_LEVEL=info
TOKEN_SECRET=
