# ============================================================
#  НОЧЬ ВОЕННОГО РЕМЕСЛА — конфигурация сервера
#  Скопируйте этот файл в server/.env и отредактируйте значения.
#  (XAMPP на Windows: DB_USER=root, DB_PASS обычно пустой)
# ============================================================
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=nvr_game
# 1 = сервер сам создаёт БД и таблицы при старте (schema.sql)
DB_AUTOINIT=1
# 1 = запуск без MySQL (хранилище в памяти, для быстрой проверки)
NO_DB=0
